#! /bin/sh

# Run a single-exec test with Babashka.
# Requires: bb (https://github.com/babashka/babashka)

set -e
set -u

t=$1

cat $t

set -x

scratchdir=$(mktemp -d)
cleanup () {
  rm -rf "$scratchdir"
}
trap cleanup EXIT

if ! bb "$t" > "$scratchdir/t.output" 2>&1
then
    cat "$scratchdir/t.output"
    exit 1
fi

if ! diff -u "$t.expected" "$scratchdir/t.output"
then
    exit 1
fi
