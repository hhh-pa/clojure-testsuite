#! /bin/sh

# Run a single-exec test with JVM Clojure via the Clojure CLI tools.
# Requires: clojure (https://clojure.org/guides/install_clojure)

set -e
set -u

t=$1

cat $t

set -x

# A cold dependency cache makes the first run print "Downloading: ..."
# progress to stderr; pre-resolve dependencies with output discarded so
# that noise never lands in the captured test output.
if ! find "$HOME/.m2/repository/org/clojure/clojure" -name 'clojure-*.jar' 2>/dev/null | grep -q .
then
    clojure -P -M "$t" > /dev/null 2>&1 || true
fi

scratchdir=$(mktemp -d)
cleanup () {
  rm -rf "$scratchdir"
}
trap cleanup EXIT

if ! clojure -M "$t" > "$scratchdir/t.output" 2>&1
then
    cat "$scratchdir/t.output"
    exit 1
fi

if ! diff -u "$t.expected" "$scratchdir/t.output"
then
    exit 1
fi
